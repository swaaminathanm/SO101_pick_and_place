format: "xrdf"

format_version: 2.0

default_joint_positions: 
  shoulder_pan: -0.0
  shoulder_lift: 0.0163
  elbow_flex: 0.0052
  wrist_flex: 0.0005
  wrist_roll: -0.0
  gripper: -0.0

cspace: 
  joint_names: 
    - "shoulder_pan"
    - "shoulder_lift"
    - "elbow_flex"
    - "wrist_flex"
    - "wrist_roll"
  acceleration_limits: [10.0, 10.0, 10.0, 10.0, 10.0]
  jerk_limits: [10000.0, 10000.0, 10000.0, 10000.0, 10000.0]

tool_frames: ["gripper_frame_link"]

world_collision: 
  geometry: "auto_generated_collision_sphere_group"

self_collision: 
  geometry: "auto_generated_collision_sphere_group"
  ignore: 
    {}

